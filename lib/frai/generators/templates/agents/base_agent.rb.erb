# frozen_string_literal: true

require "frai"

# BaseAgent is the parent class for all agents in this project.
# You don't need to modify this file — generate new agents with:
#
#   frai generate agent my_agent_name
#
# An agent uses RubyLLM's built-in tool-calling loop:
# declare tools and instructions, the LLM decides what to call and when.
#
# Example:
#   class ReviewsAgent < BaseAgent
#     tools FetchReviews, ParseReviews
#
#     instructions  # loads from agents/reviews/directives/instructions.md.erb
#   end
#
#   ReviewsAgent.call("Analyze place ChIJN1t_tDeuEmsRUsoyG83frY4")
class BaseAgent < Frai::Agent
end
