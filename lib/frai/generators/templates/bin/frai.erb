#!/usr/bin/env bash
# Frai wrapper generated by `frai setup --skill`.
# Runs frai inside this project (own Ruby version and Gemfile when present),
# isolated from the Ruby and gems of the host application.
set -euo pipefail

cd "$(dirname "$0")/.."

unset BUNDLE_GEMFILE RUBYOPT RBENV_VERSION

if [ -f Gemfile ]; then
  exec bundle exec frai "$@"
fi

exec frai "$@"
