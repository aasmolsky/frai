# Example environment variables for <%= @project_name %>
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real tokens.

# Project environment: development | test | production
# development/test: dry run — scripts run, prompts render, no MCP, no LLM
# production: real execution (CLI or API mode — see README)
FRAI_ENV=development

# LLM (production only)
# Empty + FRAI_ENV=production → CLI mode for tasks (prompt returned to client)
# Set model + API key → API mode (Frai calls LLM; required for agents)
LLM_MODEL=
LLM_API_KEY=
