# frozen_string_literal: true

# <%= @class_name %> is a Frai agent — an orchestrator that decides
# which tasks and tools to call based on LLM responses.
#
# Unlike pipelines, agents are not sequential — they can loop,
# branch, and call tools multiple times until the goal is reached.
#
# To run this agent:
#   frai exec <%= @class_name %>
#   frai exec <%= @class_name %> "your input here"
class <%= @class_name %> < BaseAgent
  # Declare inputs this agent accepts (available as methods inside `tools do`)
  # inputs :payload

# Declare directive files used by this agent — enables `frai check` validation.
  directives do
    directive :instructions
  end

  # Instructions are loaded from:
  #   agents/<%= @name %>/directives/instructions.md.erb
  instructions

  # Declare tools the agent can use:
  tools do
    # [Frai::PromptTool.for(SomeTask), Frai::PromptTool.for(AnotherTask)]
    []
  end
end
