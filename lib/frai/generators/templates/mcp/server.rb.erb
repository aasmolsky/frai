# MCP server definition for :<%= @name %>.
#
# This file registers the server so tasks can declare it as a dependency:
#   directive :main do
#     mcp :<%= @name %>
#   end
#
# Only tasks that explicitly declare `mcp :<%= @name %>` can use this server.
# Tasks without this declaration cannot access it — enforced by Frai
# before any LLM call is made.
#
# Set command and args to match how your MCP server is launched.
# Most MCP servers run via npx — check the server's documentation.

Frai::MCP.define :<%= @name %> do
  command "npx"
  args    ["-y", "@modelcontextprotocol/server-<%= @name %>"]
  # env   { "API_KEY" => ENV["<%= @name.upcase %>_API_KEY"] }
end
