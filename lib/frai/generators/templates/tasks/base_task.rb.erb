require "frai"

# BaseTask is the parent class for all tasks in this project.
# You usually don't need to modify this file.
#
# Generate a new task with:
#   frai generate task my_task_name
#
# The task contract now lives in:
#   tasks/my_task_name/task.kdl
#
# The Ruby file for each task is a thin entrypoint only:
#   class MyTask < BaseTask
#   end
class BaseTask < Frai::Task
end
