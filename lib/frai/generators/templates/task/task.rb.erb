# <%= @class_name %> — single LLM call.
#
# Entry point: tasks/<%= @name %>/directives/main.md.erb
#
# Minimal — accepts any input:
#
#   class <%= @class_name %> < BaseTask
#   end
#
#   <%= @class_name %>.call("some text")
#
# With params validation:
#
#   class <%= @class_name %> < BaseTask
#     directive :main do
#       params do
#         required :name,     String   # Frai::MissingParam if absent
#         optional :lang,     String, default: "en"
#       end
#     end
#   end
#
#   <%= @class_name %>.call(name: "item")
#
# With constants, sub-directives and scripts:
#
#   class <%= @class_name %> < BaseTask
#     const :threshold, 10
#
#     directive :main do
#       params do
#         required :query, String
#       end
#       directive :analyze do
#         script :fetch_data do
#           input   String
#           returns data: String
#         end
#       end
#     end
#   end
#
# Run:
#   frai exec <%= @class_name %>
#   frai exec <%= @class_name %> "your input"
class <%= @class_name %> < BaseTask
  directive :main
end
